{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "client/optical-sender/testdata/**/*.json",
    "server/src/optical-pwa-assets.generated.ts"
  ],
  "semi": true,
  "singleQuote": true,
  "proseWrap": "always",
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "printWidth": 80
      }
    }
  ]
}
