{
  "name": "dud",
  "version": "1.3.0",
  "private": true,
  "description": "Discreet upload / download with Cloudflare or self-hosted backends and a Dockerized client.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:caddy": "caddy run --config ./Caddyfile --watch",
    "dev:caddy:trust": "caddy trust",
    "docker:build": "./scripts/docker-build.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "serve:node": "npm run build && node dist/src/node-server.js",
    "check": "npm run format:check && npm run lint && npm test",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.60.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.94.0"
  }
}
