{
  "name": "dud",
  "version": "2.4.0",
  "private": true,
  "description": "Discreet upload / download with Cloudflare or self-hosted backends and a Dockerized client.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "cd client && GOCACHE=/tmp/dud-go-build-cache go build -trimpath -ldflags=\"-s -w -X main.version=${npm_package_version:-dev}\" -o ./bin/dud ./cmd/dud",
    "dev:caddy": "caddy run --config ./Caddyfile --watch",
    "dev:caddy:trust": "caddy trust",
    "docker:build": "./scripts/docker-build.sh",
    "format": "oxfmt && npm run format:client && npm run format:vectors && npm run format:tools && npm run format:go",
    "format:check": "oxfmt --check && npm run format:client:check && npm run format:vectors:check && npm run format:tools:check && npm run format:go:check",
    "format:client": "gofmt -w client/cmd/dud",
    "format:client:check": "test -z \"$(gofmt -l client/cmd/dud)\"",
    "format:vectors": "gofmt -w tests/vectors/protocol-v2",
    "format:vectors:check": "test -z \"$(gofmt -l tests/vectors/protocol-v2)\"",
    "format:tools": "gofmt -w tools",
    "format:tools:check": "test -z \"$(gofmt -l tools)\"",
    "format:go": "./scripts/go-tools.sh goimports && ./bin/goimports -w client/cmd/dud tests/vectors/protocol-v2 tools",
    "format:go:check": "./scripts/go-tools.sh goimports && test -z \"$(./bin/goimports -l client/cmd/dud tests/vectors/protocol-v2 tools)\"",
    "lint": "oxlint . && npm run lint:client && npm run lint:vectors && npm run lint:tools",
    "lint:client": "cd client && GOCACHE=/tmp/dud-go-build-cache go vet ./...",
    "lint:vectors": "cd tests/vectors/protocol-v2 && GOCACHE=/tmp/dud-go-build-cache go vet ./...",
    "lint:tools": "cd tools && GOCACHE=/tmp/dud-go-build-cache go vet ./...",
    "serve:node": "npm run build && node dist/src/node-server.js",
    "v2:admin": "npm run build:server && node dist/src/v2-admin.js",
    "test:client": "cd client && GOCACHE=/tmp/dud-go-build-cache go test ./...",
    "test:client:race": "cd client && GOCACHE=/tmp/dud-go-build-cache go test -race ./...",
    "test:tools": "cd tools && GOCACHE=/tmp/dud-go-build-cache go test ./...",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:coverage:client": "node scripts/test-coverage.mjs client",
    "test:coverage:server": "node scripts/test-coverage.mjs server",
    "test:e2e:v2": "./scripts/v2-docker-e2e.sh",
    "preversion": "node scripts/prepare-release.mjs check",
    "version": "node scripts/prepare-release.mjs update",
    "check:pins": "node scripts/check-pins.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:vectors": "node scripts/check-vectors.mjs",
    "tools:go": "./scripts/go-tools.sh",
    "analyze:go": "./scripts/go-analyze.sh",
    "analyze:go:gate": "./scripts/go-analyze.sh --gate",
    "analyze:go:pending": "./scripts/go-analyze.sh --pending",
    "analyze:go:strict": "./scripts/go-analyze.sh --strict",
    "analyze:staticcheck": "./scripts/go-analyze.sh staticcheck",
    "analyze:errcheck": "./scripts/go-analyze.sh errcheck",
    "analyze:gocyclo": "./scripts/go-analyze.sh gocyclo",
    "analyze:deadcode": "./scripts/go-analyze.sh deadcode",
    "analyze:vuln": "./scripts/go-analyze.sh govulncheck",
    "check:tidy": "./scripts/check-tidy.sh",
    "check": "npm run format:check && npm run lint && npm run check:pins && npm run check:tidy && npm run check:docs && npm run check:vectors && npm run analyze:go:gate && npm run test:client && npm run test:client:race && npm run test:tools && npm test",
    "release:binaries": "./scripts/build-release-binaries.sh",
    "test": "npm run build && node --import ./tests/clean-env.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "1.8.0",
    "@hpke/core": "1.9.0",
    "@hpke/hybridkem-x-wing": "0.7.0",
    "@noble/ciphers": "2.2.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "esbuild": "0.28.1",
    "miniflare": "5.20260801.1-alpha",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.60.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.94.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
