      "exports": [
        "FRAME_SIZE",
        "HIGH_DENSITY_FRAME_SIZE",
        "MAX_SOURCE_BLOCKS",
        "MAX_STRIPE_COUNT",
        "MAX_ACTIVE_STRIPES",
        "MAX_ACTIVE_SESSIONS",
        "MAX_DISTINCT_FRAMES",
        "MAX_RETAINED_EQUATIONS",
