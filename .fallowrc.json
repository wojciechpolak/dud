    {
      "file": "server/optical-receiver/src/receiver-updates.ts",
      "exports": ["readReceiverBuild"]
    }
  ],
  "usedClassMembers": [
    {
      "implements": "BlobStore",
      "members": ["put", "get", "head", "list", "delete"]
    },
    {
      "implements": "V2Store",
      "members": [
        "quotaEnforcement",
        "wholeState",
        "initialize",
        "readState",
        "transaction",
        "claimNonce",
        "deleteExpiredNonces"
      ]
    },
    {
      "implements": "V2BodyStore",
      "members": ["stage", "promote", "put", "get", "head", "delete"]
    },
    {
      "implements": "V2BodyInventory",
      "members": ["listBodies"]
    },
    {
      "implements": "V2ReconciliationRepository",
      "members": ["filterKnownBodyKeys", "listBodyKeys"]
    },
    {
      "implements": "V2PairingRepository",
      "members": [
        "find",
        "create",
        "commit",
        "compareAndSwap",
        "countActive",
        "claimRateWindow",
        "admit",
        "activate"
      ]
    },
    {
      "implements": "V2AdministrativeRepository",
      "members": [
        "claimRequestWindow",
        "revokeRelationship",
        "rotateCapability",
        "relationshipStatus"
      ]
    },
    {
      "implements": "V2RelationshipRepository",
      "members": [
        "createRelationship",
        "findRelationship",
        "commitCapabilityReissue"
      ]
    },
    {
      "implements": "V2Repository",
      "members": [
        "initialize",
        "registerCapability",
        "replaceCapabilities",
        "findCapabilityLookup",
        "findDelivery",
        "claimNonce",
        "claimNonces",
        "reserveStagedBody",
        "releaseStagedBody",
        "reserveDelivery",
        "publishDelivery",
        "queryInbox",
        "completeDelivery",
        "completeDeliveryWithControl",
        "publishControlEvent",
        "consumeControlEvents",
        "describeDurability",
        "runMaintenance"
      ]
    },
    "isV2OperationConflict"
  ],
  "overrides": [
    {
      "files": ["server/optical-receiver/public/index.html"],
      "rules": {
        "unresolved-imports": "off"
      }
    },
    {
      "files": ["tests/**/*.mjs"],
      "rules": {
        "unused-class-members": "off"
      }
    }
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "health": {
    "coverage": "coverage/fallow/coverage-final.json",
    "thresholdOverrides": [
      {
        "files": ["server/optical-receiver/**"],
        "maxCrap": 421,
        "reason": "The Istanbul map records server tests; receiver tests exercise compiled JavaScript and cannot supply TypeScript function coverage. Cyclomatic and cognitive limits still apply."
      },
      {
        "files": ["tests/**", "server/optical-receiver/test/**"],
        "maxCrap": 1000000,
        "reason": "Test code is what exercises the rest of the tree; no suite measures coverage of the tests themselves, so a CRAP score there has no coverage to weigh. Complexity limits still apply."
      }
    ]
  },
  "rules": {},
  "ignorePatterns": []
}
