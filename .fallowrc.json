{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "server/src/index.ts",
    "server/src/node-server.ts",
    "server/src/v2-admin.ts",
    "server/src/v2-d1-auth-repository.ts",
    "server/src/v2-memory-repository.ts",
    "server/src/v2-memory.ts",
    "server/optical-receiver/src/app.ts",
    "server/optical-receiver/src/decoder-worker.ts",
    "server/optical-receiver/src/simulator.ts",
    "server/optical-receiver/src/vector-gen.ts",
