    "server/optical-receiver/bench-*.mjs",
    "server/optical-receiver/profile-*.mjs",
    "server/optical-receiver/isolated-fountain-*.mjs"
  ],
  "ignoreDependencies": ["c8"],
  "ignoreExports": [
    {
      "file": "server/optical-receiver/src/replay-image.ts",
      "exports": [
        "MAX_REPLAY_PNG_BYTES",
        "MAX_REPLAY_IMAGE_SIDE",
        "MAX_REPLAY_IMAGE_PIXELS",
        "validateReplayPNGHeader"
