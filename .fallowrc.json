    {
      "file": "server/src/log.ts",
      "exports": ["redactLogText"]
    },
    {
      "file": "server/src/v2-auth.ts",
      "exports": [
        "buildV2DeliveryProof",
        "encryptV2TokenSecret",
        "V2_ENROLLMENT_KDF_ITERATIONS"
      ]
    },
    {
      "file": "server/src/v2-contract.ts",
      "exports": [
        "V2_REQUIRED_PEER_FEATURES",
        "V2_REQUIRED_GIT_FEATURES",
        "V2_ENDPOINT",
        "v2CompletionEndpoint",
        "V2_ERROR",
        "hasRequiredV2Features"
      ]
    },
    {
      "file": "server/src/v2-delivery-frame.ts",
      "exports": [
